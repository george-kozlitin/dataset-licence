<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %} - Dataset licence facts</title>
<meta name="description" content="{% block description %}{% endblock %}">
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
<meta name="theme-color" content="#e9eaed">
<script>document.documentElement.classList.add("js")</script>
<link rel="preload" href="/fonts/josefin-300.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/jost-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/style.css">
{% block head %}{% endblock %}
</head>
<body>
<div class="wrap">
<header class="top"><a class="brand" href="/"><svg viewBox="0 0 26 26" aria-hidden="true"><polygon points="7,3 19,3 25,13 19,23 7,23 1,13" fill="none" stroke="#45394f" stroke-width="1.4"/><polygon points="10,8.5 16,8.5 19,13 16,17.5 10,17.5 7,13" fill="#45394f"/></svg>datalicense</a>
<nav class="main"><a href="/signal/conflict/">Conflicts</a><a href="/about/#mcp">MCP server</a><a class="opt" href="/about/">About</a></nav></header>
<main>
{% block body %}{% endblock %}
</main>
<footer><p>{{ disclaimer }}</p><p>Data from the Hugging Face Hub. Built {{ built_at }}.</p></footer>
</div>
{% block script %}{% endblock %}
<script src="/motion.js" defer></script>
</body>
</html>
