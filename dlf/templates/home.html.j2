{% extends "base.html.j2" %}
{% block title %}Licence facts for popular Hugging Face datasets{% endblock %}
{% block description %}Licence facts for {{ total }} popular Hugging Face datasets, with recorded source declarations and evidence from automated checks.{% endblock %}
{% block body %}
<h1>Licence facts for popular Hugging Face datasets</h1>
<p>{{ total }} datasets, each with its declared licence, licence files, declared sources and the evidence behind its signal.</p>
<p class="disclaimer">{{ disclaimer }}</p>
<p><label for="q">Find a dataset by ID</label></p>
<input id="q" type="search" placeholder="e.g. squad" autocomplete="off">
<ul id="results" class="list"></ul>
<noscript><p>Search needs JavaScript. Browse the lists below instead.</p></noscript>
<h2>By signal</h2>
<ul>
{% for s in signals %}
<li><a href="/signal/{{ s }}/">{{ s | label }}</a>: {{ totals[s] }}</li>
{% endfor %}
</ul>
<h2>Potential licence conflicts among the most downloaded datasets</h2>
{% if conflicts %}
<ul class="list">
{% for e in conflicts %}
<li><a href="{{ e.href }}">{{ e.f.id }}</a> <span class="meta">{{ e.f.reason }}</span></li>
{% endfor %}
</ul>
{% else %}
<p>No potential licence conflicts flagged.</p>
{% endif %}
{% endblock %}
{% block script %}<script src="/search.js" defer></script>{% endblock %}
