{% extends "base.html.j2" %}
{% block title %}Licence facts for popular Hugging Face datasets{% endblock %}
{% block description %}Licence facts for {{ total }} popular Hugging Face datasets, with recorded source declarations and evidence from automated checks.{% endblock %}
{% block body %}
<section class="hero">
<div>
<h1>Licence facts for popular Hugging Face datasets</h1>
<p class="lede">For the {{ "{:,}".format(total) }} most downloaded datasets: the declared licence, licence files at the top level of the repository, sources listed in the card metadata, and possible licence conflicts.</p>
<label class="search" for="q"><span aria-hidden="true">&gt;</span><input id="q" type="search" placeholder="Dataset ID, e.g. squad" aria-label="Find a dataset by ID" autocomplete="off"></label>
<ul id="results"></ul>
<noscript><p class="hint">Search needs JavaScript. Browse the lists below instead.</p></noscript>
{% if examples %}<p class="hint">Try {% for e in examples %}<a href="{{ e.href }}">{{ e.f.id }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
</div>
{% if featured %}
<figure class="graph draw" style="margin:0">
{{ featured.svg }}
<figcaption><span>{{ featured.caption }}</span><a href="{{ featured.href }}">Open {{ featured.f.id }}</a></figcaption>
</figure>
{% endif %}
</section>

<section class="dist" aria-labelledby="dist">
<div class="dist-head"><h2 id="dist">{{ "{:,}".format(total) }} datasets by signal</h2><p>Rebuilt every Monday from the Hugging Face Hub</p></div>
<div class="meter" aria-hidden="true">{% for s in signals %}{% if totals[s] %}<i class="sw {{ tones[s] }}" style="flex:{{ totals[s] }};min-width:6px"></i>{% endif %}{% endfor %}</div>
<ul class="legend">
{% for s in signals %}
<li><a href="/signal/{{ s }}/"><b>{{ "{:,}".format(totals[s]) }}</b><span><i class="sw {{ tones[s] }}"></i>{{ s | label }}</span></a></li>
{% endfor %}
</ul>
</section>

<section class="list" aria-labelledby="conf">
<h2 id="conf">Possible licence conflicts among the most downloaded</h2>
{% if conflicts %}
<p class="sub">The declared licence is in a different category from a licence detected in a repository file or reported by a declared source. This indicates a possible licence conflict.</p>
<ul class="rows">
{% for e in conflicts %}
<li><a class="id" href="{{ e.href }}">{{ e.f.id }}</a><span class="why">{{ e.f.reason }}</span>{% if e.pair %}<span class="pair">{% if e.pair_ev[0] %}<a href="{{ e.pair_ev[0] }}" title="Evidence: {{ e.pair_ev[0] | ev }}">{{ e.pair[0] }}</a>{% else %}{{ e.pair[0] }}{% endif %}<span class="x" aria-label="and">×</span>{% if e.pair_ev[1] %}<a href="{{ e.pair_ev[1] }}" title="Evidence: {{ e.pair_ev[1] | ev }}">{{ e.pair[1] }}</a>{% else %}{{ e.pair[1] }}{% endif %}</span>{% else %}<span></span>{% endif %}</li>
{% endfor %}
</ul>
{% else %}
<p class="sub">No potential licence conflicts flagged.</p>
{% endif %}
</section>
{% endblock %}
{% block script %}<script src="/search.js" defer></script>{% endblock %}
