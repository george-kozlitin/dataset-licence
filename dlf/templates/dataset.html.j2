{% extends "base.html.j2" %}
{% block title %}{{ f.id }} licence{% endblock %}
{% block description %}Licence facts for the Hugging Face dataset {{ f.id }}: {{ f.signal | label }}. Declared licence: {{ f.stated_licence or "not declared" }}.{% endblock %}
{% block head %}{% if noindex %}<meta name="robots" content="noindex">{% endif %}{% endblock %}
{% block body %}
<p class="crumbs"><a href="/">All datasets</a>{% if f.owner %} / {{ f.owner }}{% endif %}</p>
<div class="dhead">
<div>
<h1 class="words">{{ words(f.id) }}</h1>
<div class="meta"><span>{{ "{:,}".format(f.downloads) }} downloads in 30 days</span><span>{{ "{:,}".format(f.likes) }} likes</span>{% if modified %}<span>Last modified {{ modified }}</span>{% endif %}<a href="{{ hf(f.id) }}">View on Hugging Face</a></div>
</div>
<a class="plate {{ tones[f.signal] }}" href="/signal/{{ f.signal }}/"><i class="hx {{ tones[f.signal] }}"></i>{{ f.signal | label }}</a>
</div>

<section class="dgrid">
<div>
<p class="reason">{{ f.reason }}</p>
<dl class="facts">
<div data-k="decl"><dt>Declared licence</dt><dd>{% if f.stated_licence %}<a class="lic" href="/licence/{{ licence_slug }}/">{{ f.stated_licence }}</a>, from the {{ f.stated_from }}{% else %}Not declared in the tag or the card (<a href="/licence/none/">see datasets with no declared licence</a>){% endif %}{% if f.stated_evidence %}<a class="ev" href="{{ f.stated_evidence }}">Evidence: {{ f.stated_evidence | ev }}</a>{% endif %}</dd></div>
{% if f.licence_name or f.licence_link %}
<div><dt>Licence name on the card</dt><dd>{{ f.licence_name or "-" }}{% if f.licence_link %}, link: {{ f.licence_link }}{% endif %}{% if f.stated_evidence %}<a class="ev" href="{{ f.stated_evidence }}">Evidence: {{ f.stated_evidence | ev }}</a>{% endif %}</dd></div>
{% endif %}
<div data-k="file"><dt>Licence files</dt><dd>{% if f.licence_files %}<code>{{ f.licence_files | join(", ") }}</code>{% if f.file_licence %}, detected as <code>{{ f.file_licence }}</code>{% else %}, licence not identified{% endif %}{% else %}No licence file at the top level of the repository{% endif %}{% if f.file_evidence %}<a class="ev" href="{{ f.file_evidence }}">Evidence: {{ f.file_evidence | ev }}</a>{% endif %}</dd></div>
<div><dt>Declared sources</dt><dd>{% if sources %}{{ sources | length }}{% else %}None listed in the card metadata{% endif %}</dd></div>
<div><dt>Access gated on Hugging Face</dt><dd>{% if f.gated is string and f.gated == "manual" %}Yes, manual approval required{% elif f.gated %}Yes{% else %}No{% endif %}</dd></div>
</dl>
</div>
<figure class="board">
{{ lineage }}
<figcaption class="note">{% if f.signal == "conflict" %}Red marks the licence the signal is based on. {% endif %}Each cell links to what was checked: a file, a file list or a Hub record.</figcaption>
</figure>
</section>

{% if sources %}
<section class="section" aria-labelledby="src">
<h2 id="src">Sources listed in the card metadata</h2>
<ul class="srcs">
{% for s in sources %}
<li data-k="{{ s.id }}"{% if s.hit %} class="hit"{% endif %}><span class="sid">{% if s.href and s.found %}<a href="{{ s.href }}">{{ s.id }}</a>{% elif s.hf and s.found %}<a href="{{ hf(s.id) }}">{{ s.id }}</a>{% else %}{{ s.id }}{% endif %}</span><span class="lic"><i class="hx {{ s.tone }}"></i>{% if s.found %}{{ s.licence or "no licence stated" }}{% else %}not found{% endif %}<span class="cat">{{ s.category }}</span></span>{% if s.evidence %}<a class="ev" href="{{ s.evidence }}">Evidence: {{ s.evidence | ev }}</a>{% endif %}</li>
{% endfor %}
</ul>
</section>
{% endif %}

<section class="section more">
{% if task_links %}
<h2>Tasks</h2>
<ul class="chips">
{% for name, slug in task_links %}
<li><a class="chip" href="/task/{{ slug }}/">{{ name }}</a></li>
{% endfor %}
</ul>
{% endif %}
{% if f.citation %}
<h2>Citation text from the card</h2>
<pre class="cite">{{ f.citation }}</pre>
{% endif %}
<p class="links"><a href="/signal/{{ f.signal }}/">All datasets marked {{ f.signal | label }}</a> | <a href="{{ json_href }}">JSON</a></p>
</section>

<section class="mcp" aria-labelledby="mcp">
<div>
<h2 id="mcp">The same facts for your agent</h2>
<p>A free MCP server at mcp.datalicense.uk/mcp. Connect it from an MCP client such as Claude or Cursor.</p>
</div>
<pre><b>dataset_licence</b>({ "id": "{{ f.id }}" })
signal: "{{ f.signal }}"
stated_licence: {% if f.stated_licence %}"{{ f.stated_licence }}"{% else %}null{% endif %}

sources: {{ sources | length }}</pre>
</section>
{% endblock %}
